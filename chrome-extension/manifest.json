{
  "manifest_version": 3,
  "name": "LLM Translator",
  "version": "1.5",
  "description": "Translate text using LLM with context awareness.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.groq.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://www.oxfordlearnersdictionaries.com/*"
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["js/models.js", "js/content.js"],
      "css": ["css/content.css"]
    }
  ]
}
